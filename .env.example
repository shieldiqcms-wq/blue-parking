# ===================================================================
# Blue Parking — متغيرات البيئة
# انسخ هذا الملف إلى .env.local وعبّي القيم
#   cp .env.example .env.local
# ===================================================================

# رابط مشروع Supabase
# مكانه: Supabase Dashboard > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (Publishable / anon)
# مكانه: Supabase Dashboard > Project Settings > API Keys > Publishable key
# هذا المفتاح آمن للاستخدام في الواجهة طالما أن RLS مفعّل على كل الجداول.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ===================================================================
# تحذير أمني:
# لا تضع هنا ولا في أي ملف داخل المستودع:
#   - service_role key
#   - secret key (sb_secret_...)
#   - كلمة مرور قاعدة البيانات
# هذه المفاتيح تتجاوز الـ RLS وتعطي صلاحية كاملة على البيانات.
# ===================================================================
